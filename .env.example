# Vite — only VITE_* variables are exposed to browser code (import.meta.env)

# Super admin email hint on login (match Backend SUPERADMIN_EMAIL)
VITE_SUPERADMIN_EMAIL=superadmin@hrms.app

# Backend API URL — used by Vite dev proxy for /api and /uploads
VITE_API_BASE_URL=http://127.0.0.1:4000

# Frontend dev server port
VITE_DEV_PORT=5173
